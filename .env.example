# Copy this file to .env and fill in your values. Never commit .env.

# --- Safety -------------------------------------------------------------
# true (default): log orders without placing them. Set to false to trade real money.
DRY_RUN=true

# --- Polymarket (required) ----------------------------------------------
CLOB_API_URL=https://clob.polymarket.com
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASS_PHRASE=
# Private key of the wallet that signs orders
PRIVATE_KEY=
# Your Polymarket proxy wallet address (also used to read your positions)
PROXY_ADDRESS=

# --- MongoDB (optional) -------------------------------------------------
# When set, every order is logged to the "orders" collection.
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_URI=
MONGODB_DB=polymarket

# --- Server -------------------------------------------------------------
PORT=3312

# --- Schedule (optional, defaults shown) --------------------------------
INTERVAL_MS=5000
TRADING_TIMEZONE=America/Los_Angeles
TRADING_START_HOUR=10
TRADING_END_HOUR=22

# --- Strategy (optional, defaults shown) --------------------------------
USD_PER_SIDE=50
MAX_ENTRY_SPREAD=0.05
MIN_ENTRY_PRICE=0.30
MAX_ENTRY_PRICE=0.70
MAX_COMBINED_ASK=1.02
STOP_LOSS_PRICE=0.25
TAKE_PROFIT_PRICE=0.96
MAX_EXIT_SPREAD=0.06
SELL_ORDER_TTL_SECONDS=65
GAME_DURATION_MINUTES=111
